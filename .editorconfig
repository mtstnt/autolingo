# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
tab_width = 2

# JavaScript / TypeScript — 2-space indentation
[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}]
indent_style = space
indent_size = 2
tab_width = 2

# Config & data
[*.{json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2

# Styles
[*.{css,scss}]
indent_style = space
indent_size = 2

# Markdown — trailing spaces are meaningful (hard line breaks)
[*.md]
trim_trailing_whitespace = false
